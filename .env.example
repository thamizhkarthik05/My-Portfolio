# ==============================================================================
# Portfolio Website Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is listed in .gitignore.
# ==============================================================================

# ─── SMTP Email Delivery (server/index.ts) ─────────────────────────────────
#
# The server uses Nodemailer with standard SMTP to deliver contact form messages.
# All settings below are required for email delivery to work.
#
# Gmail example (use an App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false        # false = STARTTLS on port 587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   # 16-char Gmail App Password
#
# Outlook / Hotmail example:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Port 465 (SSL/TLS) example:
#   SMTP_PORT=465
#   SMTP_SECURE=true
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kaarthik.m2005@gmail.com
SMTP_PASS=your-app-password-here

# ─── Recipient ──────────────────────────────────────────────────────────────
# Email address that will receive contact form submissions.
CONTACT_EMAIL=kaarthik.m2005@gmail.com

# ─── Optional: Express server port (default: 3001) ─────────────────────────
# PORT=3001

# ─── Optional: Frontend Contact Endpoint ───────────────────────────────────
# Leave blank to use default '/api/contact' route via Vite proxy.
# VITE_CONTACT_API_ENDPOINT=/api/contact
